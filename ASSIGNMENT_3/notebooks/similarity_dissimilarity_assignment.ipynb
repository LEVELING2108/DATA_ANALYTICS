    "    \"print(f'Executable: {sys.executable}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Check if running in Google Colab\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    import google.colab\\n\",\n",
    "    \"    print('Environment: Google Colab ✓')\\n\",\n",
    "    \"except ImportError:\\n\",\n",
    "    \"    print('Environment: Local Jupyter or other IDE')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Verify required libraries\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import scipy\\n\",\n",
    "    \"import sklearn\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'\\\\npandas version: {pd.__version__}')\\n\",\n",
    "    \"print(f'numpy version: {np.__version__}')\\n\",\n",
    "    \"print(f'scipy version: {scipy.__version__}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\\\n=== All dependencies available ✓ ===')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Reusable Minkowski Distance Function for Cloud Deployment\\n\",\n",
    "    \"\\n\",\n",
    "    \"def minkowski_distance_cloud(x, y, p=2):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute Minkowski distance between two vectors for parameter p.\\n\",\n",
    "    \"    This is a reusable version for cloud deployment.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"    x, y: array-like objects (lists, numpy arrays, pandas Series)\\n\",\n",
    "    \"    p: Minkowski parameter (p >= 1)\\n\",\n",
    "    \"       - p=1: Manhattan distance\\n\",\n",
    "    \"       - p=2: Euclidean distance\\n\",\n",
    "    \"       - p→∞: Chebyshev distance\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"    float: Minkowski distance value\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Example:\\n\",\n",
    "    \"    >>> minkowski_distance_cloud([1, 2, 3], [4, 5, 6], p=2)\\n\",\n",
    "    \"    5.196152422706632\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    x = np.asarray(x)\\n\",\n",
    "    \"    y = np.asarray(y)\\n\",\n",
    "    \"    return np.power(np.sum(np.abs(x - y) ** p), 1/p)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test the function\\n\",\n",
    "    \"print('=== Reusable Minkowski Distance Function ===')\\n\",\n",
    "    \"test_x = [1, 2, 3]\\n\",\n",
