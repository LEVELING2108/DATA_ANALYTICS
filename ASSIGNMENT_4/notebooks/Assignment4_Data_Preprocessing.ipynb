    "   \"source\": [\n",
    "    \"# Class balance verification\\n\",\n",
    "    \"display(Markdown(\\\"### Class Balance Verification — Before & After PCA\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"before_pca = df_sonar['Class'].value_counts()\\n\",\n",
    "    \"after_pca = df_export['Class'].value_counts()\\n\",\n",
    "    \"\\n\",\n",
    "    \"balance_table = pd.DataFrame({\\n\",\n",
    "    \"    'Class': ['R (Rock)', 'M (Mine)'],\\n\",\n",
    "    \"    'Before PCA': [before_pca.get('R', 0), before_pca.get('M', 0)],\\n\",\n",
    "    \"    'After PCA': [after_pca.get('R', 0), after_pca.get('M', 0)]\\n\",\n",
    "    \"})\\n\",\n",
    "    \"display(balance_table)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"✅ **Class balance is maintained** — PCA is a linear transformation that does not change the number of samples per class.\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Stacked bar chart for Power BI preview\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = ['Before PCA', 'After PCA']\\n\",\n",
    "    \"rock_counts = [before_pca.get('R', 0), after_pca.get('R', 0)]\\n\",\n",
    "    \"mine_counts = [before_pca.get('M', 0), after_pca.get('M', 0)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Calculate percentages\\n\",\n",
    "    \"total = rock_counts[0] + mine_counts[0]\\n\",\n",
    "    \"rock_pct = [r/total*100 for r in rock_counts]\\n\",\n",
    "    \"mine_pct = [m/total*100 for m in mine_counts]\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.bar(x, rock_pct, label='Rock', color='#3498db', edgecolor='black', alpha=0.8)\\n\",\n",
    "    \"ax.bar(x, mine_pct, bottom=rock_pct, label='Mine', color='#e74c3c', edgecolor='black', alpha=0.8)\\n\",\n",
