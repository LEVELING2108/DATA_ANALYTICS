    "    \"display(Markdown(\\\"### Part D — Export Data for Power BI\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create comprehensive export dataset\\n\",\n",
    "    \"df_export = pd.DataFrame(X_pca_optimal, columns=pca_columns)\\n\",\n",
    "    \"df_export['Class'] = y.values\\n\",\n",
    "    \"df_export['Class_Label'] = df_export['Class'].map({'R': 'Rock', 'M': 'Mine'})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add component loadings (feature importance) - top 5 PC loadings\\n\",\n",
    "    \"loadings = pca_optimal.components_.T  # Shape: (60, n_components_90)\\n\",\n",
    "    \"loading_df = pd.DataFrame(loadings, columns=[f'PC{i}' for i in range(1, n_components_90 + 1)])\\n\",\n",
    "    \"loading_df['Original_Feature'] = X.columns\\n\",\n",
    "    \"\\n\",\n",
