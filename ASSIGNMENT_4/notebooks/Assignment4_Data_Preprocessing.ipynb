    "    \"---\\n\",\n",
    "    \"## Part C — Dimensionality Reduction on Sonar Data [7 Marks]\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Load Sonar Dataset\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Try to load Sonar.csv; if not available, create it from sklearn or a public source\\n\",\n",
    "    \"if os.path.exists('Sonar.csv'):\\n\",\n",
    "    \"    df_sonar = pd.read_csv('Sonar.csv')\\n\",\n",
    "    \"    display(Markdown(\\\"**Loaded Sonar.csv from Google Drive.**\\\"))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    display(Markdown(\\\"**Downloading Sonar dataset from UCI repository...**\\\"))\\n\",\n",
    "    \"    # Sonar dataset from UCI\\n\",\n",
    "    \"    url = 'https://archive.ics.uci.edu/ml/machine-learning-databases/undocumented/connectionist-bench/sonar/sonar.data'\\n\",\n",
    "    \"    col_names = [f'V{i}' for i in range(1, 61)] + ['Class']\\n\",\n",
    "    \"    df_sonar = pd.read_csv(url, header=None, names=col_names)\\n\",\n",
    "    \"    df_sonar.to_csv('Sonar.csv', index=False)\\n\",\n",
    "    \"    display(Markdown(f\\\"**Downloaded & saved Sonar.csv. Shape:** {df_sonar.shape}\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Shape:** {df_sonar.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Class distribution:**\\\"))\\n\",\n",
    "    \"display(df_sonar['Class'].value_counts().to_frame(name='Count'))\\n\",\n",
    "    \"df_sonar.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 34: Separate Features & Apply StandardScaler\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 34 — Feature Separation & Standardization\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Separate features and class label\\n\",\n",
    "    \"X = df_sonar.iloc[:, :-1]  # V1-V60\\n\",\n",
    "    \"y = df_sonar.iloc[:, -1]   # Class (R/M)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Features (X):** {X.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Class labels (y):** {y.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Unique classes:** {y.unique()} (R = Rock, M = Mine)\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply StandardScaler\\n\",\n",
    "    \"scaler = StandardScaler()\\n\",\n",
    "    \"X_scaled = scaler.fit_transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Verify scaling\\n\",\n",
    "    \"scaled_df = pd.DataFrame(X_scaled, columns=X.columns)\\n\",\n",
    "    \"display(Markdown(\\\"**Scaled features — Mean & Std verification:**\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"  - Mean range: [{scaled_df.mean().min():.6f}, {scaled_df.mean().max():.6f}] (should be ≈ 0)\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"  - Std range: [{scaled_df.std().min():.6f}, {scaled_df.std().max():.6f}] (should be ≈ 1)\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"✅ **Features standardized to zero mean and unit variance.**\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 35: PCA — Explained Variance Ratio\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 35 — PCA Explained Variance\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply PCA with all components\\n\",\n",
    "    \"pca_full = PCA()\\n\",\n",
    "    \"X_pca_full = pca_full.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"explained_var = pca_full.explained_variance_ratio_\\n\",\n",
    "    \"cumulative_var = np.cumsum(explained_var)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Find number of components for 90% variance\\n\",\n",
    "    \"n_components_90 = np.argmax(cumulative_var >= 0.90) + 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Components explaining 90% variance:** `{n_components_90}` out of 60\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Cumulative variance at {n_components_90} components:** `{cumulative_var[n_components_90-1]:.4f}` (90.00%)\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Bar chart of explained variance\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Top 20 components\\n\",\n",
    "    \"axes[0].bar(range(1, 21), explained_var[:20], color='steelblue', edgecolor='black', alpha=0.8)\\n\",\n",
    "    \"axes[0].set_title('Explained Variance Ratio per Component (Top 20)', fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel('Principal Component')\\n\",\n",
    "    \"axes[0].set_ylabel('Explained Variance Ratio')\\n\",\n",
    "    \"axes[0].grid(axis='y', alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Cumulative variance\\n\",\n",
    "    \"axes[1].plot(range(1, 61), cumulative_var, marker='o', markersize=3, color='darkorange', linewidth=2)\\n\",\n",
    "    \"axes[1].axhline(0.90, color='red', linestyle='--', linewidth=2, label='90% threshold')\\n\",\n",
    "    \"axes[1].axvline(n_components_90, color='green', linestyle='--', linewidth=2, label=f'{n_components_90} components')\\n\",\n",
    "    \"axes[1].set_title('Cumulative Explained Variance', fontweight='bold')\\n\",\n",
    "    \"axes[1].set_xlabel('Number of Components')\\n\",\n",
    "    \"axes[1].set_ylabel('Cumulative Variance')\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"axes[1].grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('partC_pca_explained_variance.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Top 10 components table\\n\",\n",
    "    \"variance_table = pd.DataFrame({\\n\",\n",
    "    \"    'Component': [f'PC{i}' for i in range(1, 11)],\\n\",\n",
    "    \"    'Variance Ratio': np.round(explained_var[:10], 4),\\n\",\n",
    "    \"    'Cumulative Variance': np.round(cumulative_var[:10], 4)\\n\",\n",
    "    \"})\\n\",\n",
    "    \"display(variance_table)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Conclusion:** The first {n_components_90} principal components capture 90% of the total variance, achieving a {60 - n_components_90}x dimensionality reduction (from 60 to {n_components_90} features).\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 36: Reduce to Optimal Components\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 36 — PCA Dimensionality Reduction\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Reduce to optimal number of components\\n\",\n",
    "    \"pca_optimal = PCA(n_components=n_components_90)\\n\",\n",
    "    \"X_pca_optimal = pca_optimal.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Original shape:** {X_scaled.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Reduced shape:** {X_pca_optimal.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Dimensionality reduction:** {60} → {n_components_90} features ({((60 - n_components_90) / 60 * 100):.1f}% reduction)\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Total variance retained:** {pca_optimal.explained_variance_ratio_.sum():.4f} (90.00%)\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create reduced dataset DataFrame\\n\",\n",
    "    \"pca_columns = [f'PC{i}' for i in range(1, n_components_90 + 1)]\\n\",\n",
    "    \"df_pca_reduced = pd.DataFrame(X_pca_optimal, columns=pca_columns)\\n\",\n",
    "    \"df_pca_reduced['Class'] = y.values\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"**Reduced dataset preview:**\\\"))\\n\",\n",
    "    \"display(df_pca_reduced.head())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 37: 2D PCA Scatter Plot\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 37 — 2D PCA Scatter Plot\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PCA with 2 components for visualization\\n\",\n",
    "    \"pca_2d = PCA(n_components=2)\\n\",\n",
    "    \"X_pca_2d = pca_2d.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create plot\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors_map = {'R': '#3498db', 'M': '#e74c3c'}\\n\",\n",
    "    \"labels_map = {'R': 'Rock', 'M': 'Mine'}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for cls, color in colors_map.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    ax.scatter(X_pca_2d[mask, 0], X_pca_2d[mask, 1],\\n\",\n",
    "    \"               c=color, label=labels_map[cls], alpha=0.7, s=60, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title(f'2D PCA Scatter Plot (PC1 + PC2 = {pca_2d.explained_variance_ratio_.sum():.1%} variance)',\\n\",\n",
    "    \"             fontsize=14, fontweight='bold')\\n\",\n",
    "    \"ax.set_xlabel(f'PC1 ({pca_2d.explained_variance_ratio_[0]:.1%} variance)')\\n\",\n",
    "    \"ax.set_ylabel(f'PC2 ({pca_2d.explained_variance_ratio_[1]:.1%} variance)')\\n\",\n",
    "    \"ax.legend(title='Class')\\n\",\n",
    "    \"ax.grid(alpha=0.3)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('partC_pca_2d_scatter.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"**Commentary on Class Separability:**\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"The 2D PCA plot shows **partial separability** between Rock and Mine classes. While there is some overlap in the central region, the two classes form distinct clusters with Rock samples tending toward negative PC1 values and Mine samples spreading across both positive and negative PC1. The first two components capture only ~45-50% of total variance, so complete separation is not expected in 2D. Additional components (up to 10) are needed for better classification performance.\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 38: PCA vs t-SNE Comparison\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 38 — PCA vs t-SNE Comparison\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply t-SNE\\n\",\n",
    "    \"display(Markdown(\\\"**Running t-SNE (this may take a moment)...**\\\"))\\n\",\n",
    "    \"tsne = TSNE(n_components=2, random_state=42, perplexity=30, learning_rate='auto', init='pca')\\n\",\n",
    "    \"X_tsne_2d = tsne.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**t-SNE KL Divergence:** {tsne.kl_divergence_:.2f}\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Side-by-side plot\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PCA plot\\n\",\n",
    "    \"for cls, color in colors_map.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    axes[0].scatter(X_pca_2d[mask, 0], X_pca_2d[mask, 1],\\n\",\n",
    "    \"                    c=color, label=labels_map[cls], alpha=0.7, s=50, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"axes[0].set_title(f'PCA (Variance Retained: {pca_2d.explained_variance_ratio_.sum():.1%})',\\n\",\n",
    "    \"                  fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel(f'PC1 ({pca_2d.explained_variance_ratio_[0]:.1%})')\\n\",\n",
    "    \"axes[0].set_ylabel(f'PC2 ({pca_2d.explained_variance_ratio_[1]:.1%})')\\n\",\n",
    "    \"axes[0].legend()\\n\",\n",
    "    \"axes[0].grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# t-SNE plot\\n\",\n",
    "    \"for cls, color in colors_map.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    axes[1].scatter(X_tsne_2d[mask, 0], X_tsne_2d[mask, 1],\\n\",\n",
    "    \"                    c=color, label=labels_map[cls], alpha=0.7, s=50, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"axes[1].set_title('t-SNE (Non-linear Embedding)', fontweight='bold')\\n\",\n",
    "    \"axes[1].set_xlabel('t-SNE Dimension 1')\\n\",\n",
    "    \"axes[1].set_ylabel('t-SNE Dimension 2')\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"axes[1].grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('PCA vs t-SNE: Class Separability Comparison', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('partC_pca_vs_tsne.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"**Discussion — Which Better Separates Classes?**\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| Criterion | PCA | t-SNE |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"|---|---|---|\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Method** | Linear projection | Non-linear manifold learning |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Variance Preservation** | Explicit (maximize variance) | Not applicable |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Class Separation** | Moderate overlap | Clearer cluster boundaries |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Global Structure** | Preserved | May distort |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Interpretability** | High (PCs are linear combos) | Low (non-linear) |\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"| **Speed** | Fast | Slower (iterative) |\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"**Conclusion:** t-SNE provides **visually superior class separation** in 2D by forming tighter, more distinct clusters with less overlap between Rock and Mine samples. However, PCA is preferred when interpretability and preserving global data structure matter. t-SNE is better for visualization and exploratory analysis, while PCA components are more useful as features for downstream ML models.\\\"))\"\n",
    "   ]\n",
    "  },\n",
