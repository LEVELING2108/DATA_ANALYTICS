    "    \"display(Markdown(\\\"✅ **Saved:** `sonar_pca_reduced.csv`\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Top loadings\\n\",\n",
    "    \"loadings = pca_optimal.components_.T\\n\",\n",
    "    \"loading_df = pd.DataFrame(loadings, columns=[f'PC{i}' for i in range(1, n_components_90 + 1)])\\n\",\n",
    "    \"loading_df['Feature'] = X.columns\\n\",\n",
    "    \"\\n\",\n",
    "    \"top5 = loading_df.nlargest(5, 'PC1')\\n\",\n",
