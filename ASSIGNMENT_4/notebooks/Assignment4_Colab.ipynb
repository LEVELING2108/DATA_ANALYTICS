    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 41 — Class Balance Before & After PCA\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"before_pca = df_sonar['Class'].value_counts()\\n\",\n",
    "    \"after_pca = df_export['Class'].value_counts()\\n\",\n",
    "    \"total = before_pca.sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"rock_pct = [before_pca.get('R', 0)/total*100, after_pca.get('R', 0)/total*100]\\n\",\n",
    "    \"mine_pct = [before_pca.get('M', 0)/total*100, after_pca.get('M', 0)/total*100]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 5))\\n\",\n",
    "    \"x = ['Before PCA', 'After PCA']\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.bar(x, rock_pct, label='Rock', color='#3498db', edgecolor='black', alpha=0.85)\\n\",\n",
    "    \"ax.bar(x, mine_pct, bottom=rock_pct, label='Mine', color='#e74c3c', edgecolor='black', alpha=0.85)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, (r, m) in enumerate(zip(rock_pct, mine_pct)):\\n\",\n",
    "    \"    ax.text(i, r/2, f'{r:.1f}%', ha='center', va='center', fontweight='bold', color='white', fontsize=12)\\n\",\n",
    "    \"    ax.text(i, r + m/2, f'{m:.1f}%', ha='center', va='center', fontweight='bold', color='white', fontsize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title('Class Distribution: Rock vs Mine', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"ax.set_ylabel('Percentage (%)')\\n\",\n",
    "    \"ax.legend()\\n\",\n",
    "    \"ax.set_ylim(0, 105)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.savefig('partD_class_balance.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Before:** Rock={before_pca.get('R', 0)} ({rock_pct[0]:.1f}%), Mine={before_pca.get('M', 0)} ({mine_pct[0]:.1f}%)\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**After:** Rock={after_pca.get('R', 0)} ({rock_pct[1]:.1f}%), Mine={after_pca.get('M', 0)} ({mine_pct[1]:.1f}%)\\\"))\\n\",\n",
    "    \"display(Markdown(\\\"✅ **Class balance preserved** after PCA.\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
