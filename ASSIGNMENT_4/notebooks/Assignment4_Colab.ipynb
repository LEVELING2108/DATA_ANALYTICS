    "    \"display(top5[['Feature', 'PC1']].style.hide_index())\\n\",\n",
    "    \"\\n\",\n",
    "    \"loading_df.to_csv('sonar_pca_loadings.csv', index=False)\\n\",\n",
    "    \"display(Markdown(\\\"✅ **Saved:** `sonar_pca_loadings.csv`\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
