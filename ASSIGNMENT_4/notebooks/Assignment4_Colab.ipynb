    "    \"### Task 39-40: Export PCA Data & Loadings\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 39-40 — Export PCA Data & Top Loadings\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create export DataFrame\\n\",\n",
    "    \"pca_columns = [f'PC{i}' for i in range(1, n_components_90 + 1)]\\n\",\n",
    "    \"df_export = pd.DataFrame(X_pca_optimal, columns=pca_columns)\\n\",\n",
    "    \"df_export['Class'] = y.values\\n\",\n",
    "    \"df_export['Class_Label'] = df_export['Class'].map({'R': 'Rock', 'M': 'Mine'})\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**PCA-reduced shape:** {df_export.shape}\\\"))\\n\",\n",
    "    \"display(df_export.head())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save CSV\\n\",\n",
