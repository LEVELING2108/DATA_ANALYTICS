    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Part C — Dimensionality Reduction on Sonar Data [7 Marks]\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Load Sonar Dataset\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Download Sonar dataset from UCI if not exists\\n\",\n",
    "    \"if not os.path.exists('Sonar.csv'):\\n\",\n",
    "    \"    print(\\\"Downloading Sonar dataset from UCI repository...\\\")\\n\",\n",
    "    \"    url = 'https://archive.ics.uci.edu/ml/machine-learning-databases/undocumented/connectionist-bench/sonar/sonar.data'\\n\",\n",
    "    \"    col_names = [f'V{i}' for i in range(1, 61)] + ['Class']\\n\",\n",
    "    \"    df_sonar = pd.read_csv(url, header=None, names=col_names)\\n\",\n",
    "    \"    df_sonar.to_csv('Sonar.csv', index=False)\\n\",\n",
    "    \"    print(\\\"Downloaded.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    df_sonar = pd.read_csv('Sonar.csv')\\n\",\n",
    "    \"    print(\\\"Loaded from local file.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Shape:** {df_sonar.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Class distribution:**\\\"))\\n\",\n",
    "    \"display(df_sonar['Class'].value_counts().to_frame(name='Count'))\\n\",\n",
    "    \"df_sonar.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 34: Separate Features & Apply StandardScaler\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 34 — Feature Separation & Standardization\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"X = df_sonar.iloc[:, :-1]  # V1-V60\\n\",\n",
    "    \"y = df_sonar.iloc[:, -1]   # Class (R/M)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Features (X):** {X.shape}\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Class labels (y):** {y.value_counts().to_dict()}\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply StandardScaler\\n\",\n",
    "    \"scaler = StandardScaler()\\n\",\n",
    "    \"X_scaled = scaler.fit_transform(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"scaled_df = pd.DataFrame(X_scaled, columns=X.columns)\\n\",\n",
    "    \"display(Markdown(f\\\"✅ **Standardized:** Mean range [{scaled_df.mean().min():.6f}, {scaled_df.mean().max():.6f}], Std range [{scaled_df.std().min():.6f}, {scaled_df.std().max():.6f}]\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 35: PCA — Explained Variance Ratio\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 35 — PCA Explained Variance\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"pca_full = PCA()\\n\",\n",
    "    \"X_pca_full = pca_full.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"explained_var = pca_full.explained_variance_ratio_\\n\",\n",
    "    \"cumulative_var = np.cumsum(explained_var)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Find components for 90% variance\\n\",\n",
    "    \"n_components_90 = np.argmax(cumulative_var >= 0.90) + 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Components for 90% variance:** `{n_components_90}` out of 60\\\"))\\n\",\n",
    "    \"display(Markdown(f\\\"**Cumulative variance:** `{cumulative_var[n_components_90-1]:.4f}` ({cumulative_var[n_components_90-1]:.2%})\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].bar(range(1, 21), explained_var[:20], color='steelblue', edgecolor='black', alpha=0.8)\\n\",\n",
    "    \"axes[0].set_title('Explained Variance Ratio (Top 20)', fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel('Principal Component')\\n\",\n",
    "    \"axes[0].set_ylabel('Variance Ratio')\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[1].plot(range(1, 61), cumulative_var, marker='o', markersize=3, color='darkorange', linewidth=2)\\n\",\n",
    "    \"axes[1].axhline(0.90, color='red', linestyle='--', linewidth=2, label='90% threshold')\\n\",\n",
    "    \"axes[1].axvline(n_components_90, color='green', linestyle='--', linewidth=2, label=f'{n_components_90} components')\\n\",\n",
    "    \"axes[1].set_title('Cumulative Variance', fontweight='bold')\\n\",\n",
    "    \"axes[1].set_xlabel('Components')\\n\",\n",
    "    \"axes[1].set_ylabel('Cumulative Variance')\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('partC_pca_variance.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 36-37: PCA 2D Visualization\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 36-37 — PCA with Optimal Components & 2D Visualization\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply PCA with optimal components\\n\",\n",
    "    \"pca_optimal = PCA(n_components=n_components_90)\\n\",\n",
    "    \"X_pca_optimal = pca_optimal.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**Reduced:** 60 → {n_components_90} features ({(1 - n_components_90/60)*100:.1f}% reduction)\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2D PCA\\n\",\n",
    "    \"pca_2d = PCA(n_components=2)\\n\",\n",
    "    \"X_pca_2d = pca_2d.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors_class = {'R': '#3498db', 'M': '#e74c3c'}\\n\",\n",
    "    \"labels_class = {'R': 'Rock', 'M': 'Mine'}\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 7))\\n\",\n",
    "    \"for cls, color in colors_class.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    ax.scatter(X_pca_2d[mask, 0], X_pca_2d[mask, 1],\\n\",\n",
    "    \"               c=color, label=labels_class[cls], alpha=0.7, s=60, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title(f'2D PCA (PC1+PC2 = {pca_2d.explained_variance_ratio_.sum():.1%} variance)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"ax.set_xlabel(f'PC1 ({pca_2d.explained_variance_ratio_[0]:.1%})')\\n\",\n",
    "    \"ax.set_ylabel(f'PC2 ({pca_2d.explained_variance_ratio_[1]:.1%})')\\n\",\n",
    "    \"ax.legend(title='Class')\\n\",\n",
    "    \"ax.grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.savefig('partC_pca_2d_scatter.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Task 38: t-SNE Comparison\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"display(Markdown(\\\"### Task 38 — t-SNE Non-linear Dimensionality Reduction\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"tsne = TSNE(n_components=2, random_state=42, perplexity=30, learning_rate='auto', init='pca')\\n\",\n",
    "    \"X_tsne_2d = tsne.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(f\\\"**t-SNE KL Divergence:** {tsne.kl_divergence_:.2f}\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot comparison\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PCA\\n\",\n",
    "    \"for cls, color in colors_class.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    axes[0].scatter(X_pca_2d[mask, 0], X_pca_2d[mask, 1],\\n\",\n",
    "    \"                    c=color, label=labels_class[cls], alpha=0.7, s=50, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"axes[0].set_title(f'PCA ({pca_2d.explained_variance_ratio_.sum():.1%} variance)', fontweight='bold')\\n\",\n",
    "    \"axes[0].legend()\\n\",\n",
    "    \"axes[0].grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# t-SNE\\n\",\n",
    "    \"for cls, color in colors_class.items():\\n\",\n",
    "    \"    mask = y == cls\\n\",\n",
    "    \"    axes[1].scatter(X_tsne_2d[mask, 0], X_tsne_2d[mask, 1],\\n\",\n",
    "    \"                    c=color, label=labels_class[cls], alpha=0.7, s=50, edgecolors='black', linewidth=0.5)\\n\",\n",
    "    \"axes[1].set_title(f't-SNE (KL: {tsne.kl_divergence_:.2f})', fontweight='bold')\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"axes[1].grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('PCA vs t-SNE Comparison', fontsize=15, fontweight='bold')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('partC_pca_vs_tsne.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(\\\"**Observation:** t-SNE provides better class separation for non-linear sonar data structures.\\\"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
